# Binary
/bin/*
!/bin/.gitkeep

# SQLite databases
*.db
*.db-shm
*.db-wal

# Go test cache / coverage
*.test
*.out

# OS
.DS_Store
Thumbs.db

# poll-feeds.sh のログ
/logs/*
!/logs/.gitkeep

# Local config (contains secrets)
/internal/config/config.yml

# Web frontend build output (web/frontend/ の `npm run build` で生成される)
/web/static/*
!/web/static/.gitkeep
